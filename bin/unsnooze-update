#!/usr/bin/env bash
# Verified fork updater; never install from the upstream npm tag.
set -euo pipefail
task_repo="${UNSNOOZE_FORK_REPO:-$HOME/projects/unsnooze}"
cd "$task_repo"
task_lock="$(git rev-parse --git-path unsnooze-update.lock)"
exec 9> "$task_lock"
flock -n 9 || exit 0
test "$(git branch --show-current)" = main
test -z "$(git status --porcelain)"
case "$(git remote get-url origin)" in
  git@github.com:PulseBeat02/unsnooze.git|https://github.com/PulseBeat02/unsnooze.git) ;;
  *) printf '%s\n' 'Refusing update: origin is not the configured owner fork.' >&2; exit 1 ;;
esac
git pull --ff-only origin main
npm ci --no-audit --no-fund
npm test
npm run lint
task_pack_dir="$(mktemp -d)"
trap 'rm -rf -- "$task_pack_dir"' EXIT
npm pack --pack-destination "$task_pack_dir" --silent
npm install -g "$task_pack_dir"/*.tgz --no-audit --no-fund
unsnooze --version
unsnooze daemon ensure
